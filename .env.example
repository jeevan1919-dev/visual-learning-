# ====================================================================
# VisualLearn AI - Root Environment Variables Example
# ====================================================================

# --------------------------------------------------------------------
# Backend Configuration
# --------------------------------------------------------------------
# Project Settings
PROJECT_NAME="VisualLearn AI"
SECRET_KEY="your-super-secret-jwt-key-replace-in-production"

# Database (Default: SQLite local database for instant zero-setup development)
DATABASE_URL="sqlite:///./visuallearn.db"
# For PostgreSQL / Supabase Postgres:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Credentials (Optional for cloud sync & auth verification)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# AI Provider Configuration
# Options: "auto" (detects available key), "gemini", "openai", "demo"
AI_PROVIDER="auto"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# --------------------------------------------------------------------
# Frontend Configuration
# --------------------------------------------------------------------
VITE_API_URL="/api"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
